        </activity-alias>

        <activity-alias
            android:name=".AppIconMlm"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_mlm"
            android:roundIcon="@mipmap/ic_launcher_mlm"
            android:enabled="false"
            android:exported="true">
            <meta-data
                android:name="tauri-plugin-app-icon-id"
                android:value="mlm" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
